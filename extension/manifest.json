{
  "manifest_version": 3,
  "name": "Selkokieli",
  "version": "2.3.0",
  "description": "Lue artikkeleita ilman häiriötekijöitä – muuntaa verkkosivut puhtaaksi tekstiksi Selkokieli-parserilla.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "Avaa Selkokieli-lukutila",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
